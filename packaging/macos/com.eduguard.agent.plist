<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eduguard.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/eduguard-agent</string>
    <string>run</string>
  </array>
  <!-- LaunchAgent: runs inside each user's GUI login session so the tray
       icon, screen blanking overlay and Screen Recording capture work. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/eduguard-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/eduguard-agent.log</string>
</dict>
</plist>
