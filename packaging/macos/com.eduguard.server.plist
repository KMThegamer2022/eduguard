<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eduguard.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/eduguard-server</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/eduguard-server.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/eduguard-server.log</string>
</dict>
</plist>
